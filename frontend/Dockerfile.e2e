# Production build of the frontend for the end-to-end stack (docker-compose.e2e.yml). The dev
# image (Dockerfile) runs `next dev` over a bind mount; Playwright tests a built app instead, so a
# page is not compiled on its first visit while a test waits on it. Not a hardened production
# image (that comes with deployment, E5).

# Node 22 LTS, the same major as Dockerfile and the frontend CI job.
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Inlined into the client bundle by `next build` (next.config.ts): where the browser calls the API.
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# The standalone output (next.config.ts `output: "standalone"`) with its static files.
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
USER node
EXPOSE 3000
CMD ["node", "server.js"]
