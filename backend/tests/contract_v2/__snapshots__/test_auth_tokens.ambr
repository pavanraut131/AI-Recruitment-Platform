# name: test_password_reset
  dict({
    'changed_email': dict({
      'html': '''
        <!doctype html>
        <html lang="en">
        <body style="font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.5;color:#1f2421">
        <p>Hi ada, the password of your HireFlow AI account was just changed, and every browser that was signed in has been signed out.</p>
        <p><a href="http://localhost:3000/forgot-password" style="display:inline-block;padding:10px 16px;background:#2f5d46;color:#ffffff;text-decoration:none;border-radius:6px">Reset your password</a></p>
        <p>If this wasn&#x27;t you, reset your password now.</p>
        <p style="color:#5b625e;font-size:13px">HireFlow AI</p>
        </body>
        </html>
  
      ''',
      'subject': 'Your HireFlow AI password was changed',
      'text': '''
        Hi ada, the password of your HireFlow AI account was just changed, and every browser that was signed in has been signed out.
        
        If this wasn't you, reset your password now: http://localhost:3000/forgot-password
        
        HireFlow AI
  
      ''',
      'to': 'ada@example.com',
    }),
    'confirm': dict({
      'body': '',
      'headers': dict({
        'content-type': 'application/json',
        'retry-after': None,
      }),
      'set-cookie': list([
        'hf_csrf=""; expires=<date>; Max-Age=0; Path=/; SameSite=strict',
        'hf_session=""; expires=<date>; HttpOnly; Max-Age=0; Path=/; SameSite=lax',
      ]),
      'status_code': 204,
    }),
    'confirm_again': dict({
      'body': dict({
        'detail': 'This link has expired or was already used. Ask for a new one.',
        'status': 410,
        'title': 'Gone',
        'type': 'about:blank',
      }),
      'headers': dict({
        'content-type': 'application/problem+json',
        'retry-after': None,
      }),
      'status_code': 410,
    }),
    'confirm_weak': dict({
      'body': dict({
        'detail': '1 invalid field',
        'errors': list([
          dict({
            'loc': list([
              'body',
              'new_password',
            ]),
            'msg': 'Use at least 12 characters',
          }),
        ]),
        'status': 422,
        'title': 'Unprocessable Entity',
        'type': 'about:blank',
      }),
      'headers': dict({
        'content-type': 'application/problem+json',
        'retry-after': None,
      }),
      'status_code': 422,
    }),
    'request': dict({
      'body': dict({
        'detail': "If an account exists for this address, we've sent it a link to choose a new password.",
      }),
      'headers': dict({
        'content-type': 'application/json',
        'retry-after': None,
      }),
      'status_code': 202,
    }),
    'request_over_the_limit': dict({
      'body': dict({
        'detail': 'Too many attempts. Try again later.',
        'status': 429,
        'title': 'Too Many Requests',
        'type': 'about:blank',
      }),
      'headers': dict({
        'content-type': 'application/problem+json',
        'retry-after': '<seconds>',
      }),
      'status_code': 429,
    }),
    'request_unknown': dict({
      'body': dict({
        'detail': "If an account exists for this address, we've sent it a link to choose a new password.",
      }),
      'headers': dict({
        'content-type': 'application/json',
        'retry-after': None,
      }),
      'status_code': 202,
    }),
    'reset_email': dict({
      'html': '''
        <!doctype html>
        <html lang="en">
        <body style="font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.5;color:#1f2421">
        <p>Hi ada, someone asked to reset the password of your HireFlow AI account.</p>
        <p><a href="http://localhost:3000/reset-password#token=<token>" style="display:inline-block;padding:10px 16px;background:#2f5d46;color:#ffffff;text-decoration:none;border-radius:6px">Choose a new password</a></p>
        <p>The link works once, for 30 minutes. Choosing a new password signs you out everywhere.</p>
        <p>If you didn&#x27;t ask for this, ignore this email: your password stays as it is.</p>
        <p style="color:#5b625e;font-size:13px">HireFlow AI</p>
        </body>
