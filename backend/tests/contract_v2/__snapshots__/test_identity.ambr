# name: test_auth
  dict({
    'csrf': dict({
      'body': dict({
        'csrf_token': '<csrf-token>',
      }),
      'headers': dict({
        'content-type': 'application/json',
      }),
      'set-cookie': list([
        'hf_csrf=<value>; Path=/; SameSite=strict',
      ]),
      'status_code': 200,
    }),
    'login': dict({
      'body': dict({
        'active_agency': dict({
          'id': '<default-agency>',
          'name': 'Default agency',
        }),
        'client_scope': dict({
          'all_clients': True,
          'client_ids': list([
          ]),
        }),
        'csrf_token': '<csrf-token>',
        'memberships': list([
          dict({
            'agency': dict({
              'id': '<default-agency>',
              'name': 'Default agency',
            }),
            'role': 'owner',
          }),
        ]),
        'permissions': list([
          'workspace:read',
          'campaign:write',
          'campaign:delete',
          'resume:upload',
          'application:review',
          'application:delete',
          'application:export',
          'client:read',
          'client:manage',
          'team:read',
          'team:manage',
          'team:manage_privileged',
          'agency:manage',
        ]),
        'role': 'owner',
        'user': dict({
          'display_name': 'ada',
          'email': 'ada@example.com',
          'id': '<uuid:1>',
        }),
      }),
      'headers': dict({
        'content-type': 'application/json',
      }),
      'set-cookie': list([
        'hf_csrf=<value>; Path=/; SameSite=strict',
        'hf_session=<value>; HttpOnly; Max-Age=604800; Path=/; SameSite=lax',
      ]),
      'status_code': 200,
    }),
    'login_invalid_body': dict({
      'body': dict({
        'detail': '1 invalid field',
        'errors': list([
          dict({
            'loc': list([
              'body',
              'password',
            ]),
            'msg': 'Field required',
          }),
        ]),
        'status': 422,
        'title': 'Unprocessable Entity',
        'type': 'about:blank',
      }),
      'headers': dict({
        'content-type': 'application/problem+json',
      }),
      'status_code': 422,
    }),
    'login_without_csrf': dict({
      'body': dict({
        'detail': 'CSRF token missing or invalid',
        'status': 403,
        'title': 'Forbidden',
        'type': 'about:blank',
      }),
      'headers': dict({
        'content-type': 'application/problem+json',
      }),
      'status_code': 403,
    }),
    'login_wrong_password': dict({
      'body': dict({
        'detail': 'Invalid email or password',
        'status': 401,
        'title': 'Unauthorized',
        'type': 'about:blank',
      }),
      'headers': dict({
        'content-type': 'application/problem+json',
      }),
      'status_code': 401,
    }),
    'logout': dict({
      'body': '',
      'headers': dict({
        'content-type': 'application/json',
      }),
      'set-cookie': list([
        'hf_csrf=""; expires=<date>; Max-Age=0; Path=/; SameSite=strict',
        'hf_session=""; expires=<date>; HttpOnly; Max-Age=0; Path=/; SameSite=lax',
      ]),
      'status_code': 204,
    }),
    'logout_again': dict({
      'body': dict({
        'detail': 'CSRF token missing or invalid',
        'status': 403,
        'title': 'Forbidden',
        'type': 'about:blank',
      }),
      'headers': dict({
        'content-type': 'application/problem+json',
      }),
      'status_code': 403,
    }),
  })
