# name: test_rename_archive_and_restore_a_client
  list([
    dict({
      'body': dict({
        'created_at': '<datetime>',
        'id': '<uuid:1>',
        'name': 'Acme Holdings',
        'status': 'active',
        'updated_at': '<datetime>',
      }),
      'headers': dict({
        'content-type': 'application/json',
      }),
      'status_code': 200,
    }),
    dict({
      'body': dict({
        'created_at': '<datetime>',
        'id': '<uuid:1>',
        'name': 'Acme Holdings',
        'status': 'archived',
        'updated_at': '<datetime>',
      }),
      'headers': dict({
        'content-type': 'application/json',
      }),
      'status_code': 200,
    }),
    dict({
      'body': dict({
        'created_at': '<datetime>',
        'id': '<uuid:1>',
        'name': 'Acme Holdings',
        'status': 'archived',
        'updated_at': '<datetime>',
      }),
      'headers': dict({
        'content-type': 'application/json',
      }),
      'status_code': 200,
    }),
    dict({
      'body': dict({
        'created_at': '<datetime>',
        'id': '<uuid:1>',
        'name': 'acme holdings',
        'status': 'active',
        'updated_at': '<datetime>',
      }),
      'headers': dict({
        'content-type': 'application/json',
      }),
      'status_code': 200,
    }),
  ])
