# serializer version: 1
# name: test_create_client
  dict({
    'body': dict({
      'created_at': '<datetime>',
      'id': '<uuid:1>',
      'name': 'Northwind Traders',
      'status': 'active',
      'updated_at': '<datetime>',
    }),
    'headers': dict({
      'content-type': 'application/json',
    }),
    'status_code': 201,
  })
# ---
