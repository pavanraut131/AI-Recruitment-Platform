# name: test_list_clients
  dict({
    'body': dict({
      'items': list([
        dict({
          'created_at': '<datetime>',
          'id': '<uuid:1>',
          'name': 'Acme',
          'status': 'active',
          'updated_at': '<datetime>',
        }),
        dict({
          'created_at': '<datetime>',
          'id': '<uuid:2>',
          'name': 'beta labs',
          'status': 'active',
          'updated_at': '<datetime>',
        }),
        dict({
          'created_at': '<datetime>',
          'id': '<default-client>',
          'name': 'General',
          'status': 'active',
          'updated_at': '<datetime>',
        }),
        dict({
          'created_at': '<datetime>',
          'id': '<uuid:3>',
          'name': 'Zeta',
          'status': 'archived',
          'updated_at': '<datetime>',
        }),
      ]),
      'page': 1,
      'page_size': 20,
      'total': 4,
    }),
    'headers': dict({
      'content-type': 'application/json',
    }),
    'status_code': 200,
  })
