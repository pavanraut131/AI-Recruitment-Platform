# name: test_upload
  dict({
    'celery_calls': list([
      dict({
        'args': list([
          '<uuid:1>',
        ]),
        'kwargs': dict({
          'agency_id': '<default-agency>',
        }),
        'options': dict({
          'queue': 'extract_queue',
        }),
        'task': 'workers.extract_task.extract_resume',
      }),
    ]),
    'response': dict({
      'body': dict({
        'accepted': list([
          dict({
            'application_id': None,
            'campaign_id': '<uuid:2>',
            'error_message': None,
            'filename': 'alice.pdf',
            'id': '<uuid:1>',
            'processing_step': None,
            'retry_count': 0,
            'size_bytes': 17,
            'status': 'pending',
            'updated_at': '<datetime>',
            'uploaded_at': '<datetime>',
          }),
        ]),
        'rejected': list([
          dict({
            'filename': 'notes.txt',
            'reason': 'Only PDF files are accepted',
          }),
          dict({
            'filename': 'fake.pdf',
            'reason': 'Invalid PDF file',
          }),
          dict({
            'filename': 'again.pdf',
            'reason': 'Duplicate file (already processed successfully)',
          }),
        ]),
      }),
      'headers': dict({
        'content-type': 'application/json',
      }),
      'status_code': 202,
    }),
  })
