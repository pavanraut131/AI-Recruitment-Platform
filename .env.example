# ─── Application ────────────────────────────────────────────
APP_ENV=development
DEBUG=true
# Signs the CSRF tokens. Any value works in development; outside
# development/test the app refuses to start unless it is at least 32
# bytes and not this template value: generate one with
#   openssl rand -hex 32
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32

# ─── Sign-in (EPIC-02) ──────────────────────────────────────
# /api/v2 requires a session. Until the login screen exists (E2-09),
# false lets requests WITHOUT a session cookie act as the owner of the
# default agency, so the frontend works without signing in. Development
# and test only: the app refuses to start with false anywhere else.
# The seeded accounts (README: "Signing in locally") work either way.
AUTH_REQUIRED=false
# Secure cookies (with the __Host- prefix). Unset: on everywhere except
# APP_ENV=development/test, so plain http://localhost works.
# SESSION_COOKIE_SECURE=
# Idle and absolute session lifetimes (seconds or ISO 8601, e.g. PT8H).
# SESSION_IDLE_TIMEOUT=PT8H
# SESSION_ABSOLUTE_TIMEOUT=P7D

# ─── Email (EPIC-02 §4.4) ───────────────────────────────────
# Invitations and password resets are emailed. In Compose they go to
# Mailpit, which catches everything: read them at http://localhost:8025
# (MAILPIT_UI_HOST_PORT). console logs them instead (development and
# test only: the logs then hold the links). Links point at FRONTEND_URL.
EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false
EMAIL_FROM=HireFlow AI <no-reply@hireflow.localhost>
FRONTEND_URL=http://localhost:3000

# ─── Host ports ─────────────────────────────────────────────
# Ports published on your machine. Change any that clash with other
# local services. Containers always talk to each other on the default
# ports, so the *_URL values below do not change.
# If you change BACKEND_HOST_PORT or FRONTEND_HOST_PORT, also update
# NEXT_PUBLIC_API_URL and CORS_ORIGINS at the bottom of this file.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
FLOWER_HOST_PORT=5555
MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=1025

# ─── Database ───────────────────────────────────────────────
# POSTGRES_USER is the bootstrap superuser: administration only (psql,
# `make db-roles`). The app never connects as it.
POSTGRES_USER=resumeai
POSTGRES_PASSWORD=resumeai_secret
POSTGRES_DB=resumeai

# Row-level security (EPIC-02 spec §6.2, docs/runbooks/tenancy-rls.md):
# hireflow_owner owns the schema (Alembic and the operator commands);
# hireflow_app is what the API and the workers use. The postgres init
# script (or `make db-roles` on a volume created before E2-04) creates
# both with these passwords.
HIREFLOW_OWNER_PASSWORD=hireflow_owner_secret
HIREFLOW_APP_PASSWORD=hireflow_app_secret

# docker-compose.yml builds the three URLs from the values above, so they
# are only read when the backend runs outside Compose. Keep them in step.
# The API (async) and the Celery workers (sync) connect as hireflow_app:
DATABASE_URL=postgresql+asyncpg://hireflow_app:hireflow_app_secret@postgres:5432/resumeai
SYNC_DATABASE_URL=postgresql://hireflow_app:hireflow_app_secret@postgres:5432/resumeai
# Alembic and the operator commands that span agencies (verify, reset_stuck,
# storage_orphans, the tenancy backfill) connect as hireflow_owner:
MIGRATION_DATABASE_URL=postgresql://hireflow_owner:hireflow_owner_secret@postgres:5432/resumeai

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── MinIO (Object Storage) ─────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET_NAME=resumes
MINIO_USE_SSL=false

# ─── AI provider ────────────────────────────────────────────
# gemini: Google Gemini. Needs a real GEMINI_API_KEY below; the app
#         refuses to start without one.
# fake:   deterministic answers derived from the text, no network and no
#         API key (GEMINI_API_KEY can be left empty or removed); for local
#         dev and the end-to-end smoke test.
AI_PROVIDER=gemini

# ─── Gemini AI ──────────────────────────────────────────────
# Required when AI_PROVIDER=gemini, optional when AI_PROVIDER=fake.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ─── File Upload ────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_BATCH=50
ALLOWED_EXTENSIONS=pdf

# ─── Identity matching ──────────────────────────────────────
# Region assumed for phone numbers without a country code (ISO 3166-1
# alpha-2). "09876543210" with IN becomes +919876543210.
PHONE_DEFAULT_REGION=IN

# ─── Flower ─────────────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=admin

# ─── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
