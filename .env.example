# ─── Application ────────────────────────────────────────────
APP_ENV=development
DEBUG=true
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32

# ─── Host ports ─────────────────────────────────────────────
# Ports published on your machine. Change any that clash with other
# local services. Containers always talk to each other on the default
# ports, so the *_URL values below do not change.
# If you change BACKEND_HOST_PORT or FRONTEND_HOST_PORT, also update
# NEXT_PUBLIC_API_URL and CORS_ORIGINS at the bottom of this file.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
FLOWER_HOST_PORT=5555

# ─── Database ───────────────────────────────────────────────
POSTGRES_USER=resumeai
POSTGRES_PASSWORD=resumeai_secret
POSTGRES_DB=resumeai
DATABASE_URL=postgresql+asyncpg://resumeai:resumeai_secret@postgres:5432/resumeai

# Sync URL used by Alembic migrations
SYNC_DATABASE_URL=postgresql://resumeai:resumeai_secret@postgres:5432/resumeai

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── MinIO (Object Storage) ─────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET_NAME=resumes
MINIO_USE_SSL=false

# ─── AI provider ────────────────────────────────────────────
# gemini: Google Gemini (needs a real GEMINI_API_KEY below).
# fake:   deterministic answers derived from the text, no network and no
#         real API key needed (GEMINI_API_KEY must still be set to any
#         value); for local dev and the end-to-end smoke test.
AI_PROVIDER=gemini

# ─── Gemini AI ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ─── File Upload ────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_BATCH=50
ALLOWED_EXTENSIONS=pdf

# ─── Identity matching ──────────────────────────────────────
# Region assumed for phone numbers without a country code (ISO 3166-1
# alpha-2). "09876543210" with IN becomes +919876543210.
PHONE_DEFAULT_REGION=IN

# ─── Flower ─────────────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=admin

# ─── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
