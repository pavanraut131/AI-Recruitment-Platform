# ─── Application ────────────────────────────────────────────
APP_ENV=development
DEBUG=true
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32

# ─── Database ───────────────────────────────────────────────
POSTGRES_USER=resumeai
POSTGRES_PASSWORD=resumeai_secret
POSTGRES_DB=resumeai
DATABASE_URL=postgresql+asyncpg://resumeai:resumeai_secret@postgres:5432/resumeai

# Sync URL used by Alembic migrations
SYNC_DATABASE_URL=postgresql://resumeai:resumeai_secret@postgres:5432/resumeai

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── MinIO (Object Storage) ─────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET_NAME=resumes
MINIO_USE_SSL=false

# ─── Gemini AI ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ─── File Upload ────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_BATCH=50
ALLOWED_EXTENSIONS=pdf

# ─── Flower ─────────────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=admin

# ─── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
